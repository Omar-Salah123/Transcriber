# Local AI extraction service configuration.
# For Vertex AI (Google Cloud):
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Or for Google AI Studio:
# GEMINI_API_KEY=

# Confirm this model name is available to your project before a live pilot.
GEMINI_MODEL=gemini-3.8-flash

AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8100
